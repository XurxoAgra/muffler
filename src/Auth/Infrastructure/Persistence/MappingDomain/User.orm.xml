<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Auth\Domain\User\User" table="users">
        <id name="id" type="user_id">
            <generator strategy="NONE"/>
        </id>

        <unique-constraints>
            <unique-constraint name="uniq_users_email" columns="email"/>
        </unique-constraints>

        <field name="email" type="user_email"/>
        <field name="password" type="user_password"/>
        <field name="firstName" type="string" length="100" column="first_name"/>
        <field name="lastName" type="string" length="100" column="last_name"/>
        <field name="roles" type="user_roles"/>
        <field name="createdAt" type="datetime" column="created_at"/>
        <field name="updatedAt" type="datetime" column="updated_at"/>
    </entity>
</doctrine-mapping>
