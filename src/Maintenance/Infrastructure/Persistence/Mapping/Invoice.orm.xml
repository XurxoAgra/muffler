<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Maintenance\Domain\Invoice" table="invoices">
        <id name="id" type="uuid">
            <generator strategy="NONE"/>
        </id>

        <field name="filePath" type="string" length="255" column="file_path"/>
        <field name="amount" type="decimal" precision="10" scale="2" nullable="true"/>
        <field name="date" type="date_immutable" nullable="true"/>
        <field name="shopName" type="string" length="255" column="shop_name" nullable="true"/>
        <field name="description" type="text" nullable="true"/>
        <field name="status" type="string" length="20" enum-type="App\Maintenance\Domain\InvoiceStatus"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>

        <many-to-one field="vehicle" target-entity="App\Vehicle\Domain\Vehicle">
            <join-column name="vehicle_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="uploadedBy" target-entity="App\Auth\Domain\User\User">
            <join-column name="uploaded_by" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
