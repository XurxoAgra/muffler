<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Maintenance\Domain\MaintenanceRecord" table="maintenance_records">
        <id name="id" type="uuid">
            <generator strategy="NONE"/>
        </id>

        <field name="serviceDate" type="date_immutable" column="service_date"/>
        <field name="mileage" type="integer" nullable="true"/>
        <field name="notes" type="text" nullable="true"/>
        <field name="cost" type="decimal" precision="10" scale="2" nullable="true"/>
        <field name="shopName" type="string" length="255" column="shop_name" nullable="true"/>
        <field name="nextServiceDate" type="date_immutable" column="next_service_date" nullable="true"/>
        <field name="verified" type="boolean"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>

        <many-to-one field="vehicle" target-entity="App\Vehicle\Domain\Vehicle">
            <join-column name="vehicle_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="maintenanceRecordType" target-entity="App\Maintenance\Domain\MaintenanceRecordType">
            <join-column name="maintenance_record_type_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="invoice" target-entity="App\Maintenance\Domain\Invoice">
            <join-column name="invoice_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <many-to-one field="createdBy" target-entity="App\Auth\Domain\User\User">
            <join-column name="created_by" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
