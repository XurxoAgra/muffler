<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Vehicle\Domain\MileageRecord" table="mileage_records">
        <id name="id" type="uuid">
            <generator strategy="NONE"/>
        </id>

        <field name="mileage" type="integer"/>
        <field name="recordedAt" type="datetime_immutable" column="recorded_at"/>
        <field name="source" type="string" length="30" enum-type="App\Vehicle\Domain\MileageSource"/>

        <many-to-one field="vehicle" target-entity="App\Vehicle\Domain\Vehicle">
            <join-column name="vehicle_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
